# --- PLC ---------------------------------------------------------------
PLC_IP=192.168.1.10
READ_INTERVAL_MS=1000

# --- Base de datos -----------------------------------------------------
POSTGRES_USER=adanvi
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=adanvi
DATABASE_URL=postgresql://adanvi:cambiame@db:5432/adanvi

# Rol de solo lectura para pgAdmin y otras herramientas externas.
# Aplicar con: uv run python scripts/grant_ro.py
ADANVI_RO_PASSWORD=cambiame

# --- App ---------------------------------------------------------------
TZ=America/Bogota
HTTP_PORT=8000
LOG_LEVEL=INFO

# 0 = sin tope de galerias
MAX_GALLERIES=0

# Minutos que el operador tiene para corregir una fila del formulario de
# operacion. Pasado ese plazo la fila queda bloqueada.
OP_EDIT_WINDOW_MIN=30

# Retenciones (dias). Cambiarlas aqui NO reescribe las policies ya creadas;
# ver README para reaplicarlas.
RETENTION_RAW_DAYS=90
RETENTION_1M_DAYS=365
RETENTION_1H_DAYS=1825
