# --- PLC Delta AS-200 (Modbus/TCP) -------------------------------------
PLC_IP=192.168.1.10
PLC_PORT=502
# Esclavo por defecto para los tags nuevos; cada tag guarda el suyo.
PLC_UNIT_ID=1
# Por debajo del periodo de ciclo: un timeout largo arrastraria la malla.
PLC_TIMEOUT_MS=800
READ_INTERVAL_MS=1000

# --- Base de datos -----------------------------------------------------
POSTGRES_USER=adanvi
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=adanvi
DATABASE_URL=postgresql://adanvi:cambiame@db:5432/adanvi

# Rol de solo lectura para pgAdmin y otras herramientas externas.
# Aplicar con: uv run python scripts/grant_ro.py
ADANVI_RO_PASSWORD=cambiame

# --- App ---------------------------------------------------------------
TZ=America/Bogota
HTTP_PORT=8000
LOG_LEVEL=INFO

# 0 = sin tope de galerias
MAX_GALLERIES=0
